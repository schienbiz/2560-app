generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Platform {
  line
  telegram
}

enum AssetType {
  stock
  crypto
}

enum SignalType {
  golden_cross
  death_cross
  proximity_golden
  proximity_exit
  none
}

enum TradeDirection {
  long
  short
}

// ─── Watchlist ────────────────────────────────────────────────────────────────
model Watchlist {
  id         String    @id @default(cuid())
  user_id    String
  platform   Platform
  symbol     String
  asset_type AssetType
  label      String?

  alert      WatchlistAlert?
  trades     TradeRecord[]

  created_at DateTime @default(now())

  @@unique([user_id, platform, symbol])
}

// ─── Signal alert settings per watchlist item ────────────────────────────────
model WatchlistAlert {
  id                  String    @id @default(cuid())
  watchlist_id        String    @unique
  watchlist           Watchlist @relation(fields: [watchlist_id], references: [id], onDelete: Cascade)

  on_golden           Boolean   @default(true)
  on_death            Boolean   @default(true)
  active              Boolean   @default(true)
  proximity_threshold Float     @default(0.015)
  fast_period         Int       @default(25)
  slow_period         Int       @default(60)
}

// ─── Manual "remind me to check this symbol on date X" ───────────────────────
model RemindMe {
  id          String    @id @default(cuid())
  user_id     String
  platform    Platform
  symbol      String
  asset_type  AssetType
  remind_date DateTime  @db.Date
  note        String?
  sent        Boolean   @default(false)
  /**
   * Abandoned without ever being delivered.
   *
   * `sent` must keep meaning "the user received this". The cron used to query
   * only reminders due TODAY, so one missed day was permanent AND silent: the
   * row stayed sent=false forever and kept showing as pending in the app. Four
   * such rows sat there from April 2026. Marking them `sent: true` to clear
   * them would have made an undelivered reminder indistinguishable from a
   * delivered one — the exact failure mode this codebase keeps finding. This
   * column records the third state instead.
   */
  expired_at  DateTime?
  created_at  DateTime  @default(now())

  @@index([remind_date, sent])
}

// ─── Global signal history (not per-user) ────────────────────────────────────
model SignalHistory {
  id                   String     @id @default(cuid())
  symbol               String
  asset_type           AssetType
  signal               SignalType
  signal_date          DateTime
  close_price          Float
  ma25                 Float
  ma60                 Float
  confidence           String     // "high" | "medium" | "low"
  outcome_5d           Float?     // % change 5 trading days after signal
  outcome_10d          Float?     // % change 10 trading days after signal
  outcome_20d          Float?     // % change 20 trading days after signal
  outcome_computed_at  DateTime?  // last computation attempt (not completion)
  strong_passed        Int?       // 強確認死叉 factors passed at the cross bar (death crosses only)
  strong_applicable    Int?       // factors with enough data — denominator for strong_passed
  benchmark_5d         Float?     // market index (BTC/SPY/0050) % change over the same +5d window
  benchmark_10d        Float?
  benchmark_20d        Float?
  created_at           DateTime   @default(now())

  trades      TradeRecord[]

  @@unique([symbol, signal_date, signal])
  @@index([symbol, signal_date])
}

// ─── Per-user notification ledger ────────────────────────────────────────────
//
// SignalHistory above is a GLOBAL record: one row per (symbol, date, signal),
// a market fact. The scan used it for both jobs and they are not the same job —
// dedup of a per-user ACTION was keyed on a global fact, so the first alert
// processed for a symbol wrote the row and every other user watching that same
// symbol found it already present and was skipped. It survived only because all
// alerts run concurrently in one Promise.allSettled and all read before the
// first write; any serialisation (connection-pool queueing, batching, a retry)
// turns it into "one person is told, the rest are silently not". Production has
// BTCUSDT watched by two distinct users on LINE and two on Telegram.
//
// This table records what was actually delivered, to whom. The unique key is
// the idempotency key: claim it with an insert, and let the constraint — not a
// read-then-write — decide who sends.
model SignalNotification {
  id          String     @id @default(cuid())
  user_id     String
  platform    Platform
  symbol      String
  signal      SignalType
  signal_date DateTime
  sent_at     DateTime   @default(now())

  @@unique([user_id, platform, symbol, signal_date, signal])
  @@index([symbol, signal_date])
}

// ─── Trade records ───────────────────────────────────────────────────────────
model TradeRecord {
  id           String         @id @default(cuid())
  user_id      String
  platform     Platform
  symbol       String
  asset_type   AssetType

  watchlist_id String?
  watchlist    Watchlist?     @relation(fields: [watchlist_id], references: [id])

  signal_id    String?
  signal       SignalHistory? @relation(fields: [signal_id], references: [id])

  direction    TradeDirection @default(long)

  entry_date   DateTime
  entry_price  Float
  exit_date    DateTime?
  exit_price   Float?
  quantity     Float?
  notes        String?

  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([user_id, platform])
}

// ─── OHLCV cache (reduces external API calls) ────────────────────────────────
model OhlcvCache {
  symbol     String
  date       DateTime @db.Date
  open       Float
  high       Float
  low        Float
  close      Float
  volume     Float
  source     String   // upstream feed: "yahoo" | "kraken" — MarketAdapter.getSource()
  fetched_at DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol, date])
}
